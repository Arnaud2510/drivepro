# Copy to .env.local and fill in. Never commit real values.
# Public (anon) key only — the service_role key must NEVER be used in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Branding (optional)
VITE_APP_NAME=DrivePro
# Web Push (optional): public VAPID key; the private key is a secret of the Edge Function only.
VITE_VAPID_PUBLIC_KEY=
