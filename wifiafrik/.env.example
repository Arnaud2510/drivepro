# URL publique du site (utilisée par CinetPay pour le retour client et les notifications).
# Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL sert de valeur par défaut.
SITE_URL=https://wifiafrik.example

# Supabase — clé service_role : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CinetPay — "sandbox" (api.cinetpay.net) ou "production" (api.cinetpay.co).
CINETPAY_ENV=sandbox

# Un compte marchand CinetPay par pays. Seuls les pays configurés sont proposés au paiement.
# Codes : CI SN ML BF TG BJ NE CM TD CG CF GA GQ
CINETPAY_CI_API_KEY=
CINETPAY_CI_API_PASSWORD=
# CINETPAY_SN_API_KEY=
# CINETPAY_SN_API_PASSWORD=
