# Supabase — clé secrète / service_role : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mode de paiement : "manual" (par défaut, Mobile Money vérifié à la main) ou "cinetpay".
PAYMENT_MODE=manual

# --- Paiement manuel ---
# Numéros de réception affichés au client. Un moyen n'est proposé que si son numéro est renseigné.
PAYMENT_ORANGE_MONEY_NUMBER=
PAYMENT_WAVE_NUMBER=
PAYMENT_MTN_MOMO_NUMBER=
PAYMENT_MOOV_MONEY_NUMBER=
# Nom du titulaire des comptes, affiché au client (facultatif).
PAYMENT_HOLDER_NAME=
# Mot de passe de la page /admin (12 caractères minimum ; sans lui, /admin est désactivée).
ADMIN_PASSWORD=

# --- CinetPay (PAYMENT_MODE=cinetpay) ---
# URL publique du site (sinon le domaine de production Vercel).
SITE_URL=
# "sandbox" (api.cinetpay.net) ou "production" (api.cinetpay.co).
CINETPAY_ENV=sandbox
# Un compte marchand par pays. Codes : CI SN ML BF TG BJ NE CM TD CG CF GA GQ
CINETPAY_CI_API_KEY=
CINETPAY_CI_API_PASSWORD=
